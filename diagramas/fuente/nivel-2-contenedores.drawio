        <mxCell id="inv" value="&lt;b style=&quot;font-size:16px&quot;&gt;Encargado de inventario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Revisa existencias y&lt;br&gt;movimientos de productos&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="150" width="340" height="120" as="geometry"/></mxCell>
        <mxCell id="adm_cab" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1514.0" y="74" width="72" height="72" as="geometry"/></mxCell>
        <mxCell id="adm" value="&lt;b style=&quot;font-size:16px&quot;&gt;Administrador de PuntoBot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Revisa las correcciones y&lt;br&gt;mantiene el asistente&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1365" y="150" width="370" height="120" as="geometry"/></mxCell>
        <mxCell id="chat" value="&lt;b style=&quot;font-size:16px&quot;&gt;Módulo de chat&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Ventana dentro del sistema de escritorio actual]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Captura la pregunta, muestra la respuesta&lt;br&gt;y el botón «no era eso»&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="400" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="back" value="&lt;b style=&quot;font-size:16px&quot;&gt;Backend de PuntoBot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Python + FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Valida, decide con umbrales,&lt;br&gt;consulta inventario y registra&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="650" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="mod" value="&lt;b style=&quot;font-size:16px&quot;&gt;Servicio del modelo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Python + scikit-learn · API REST]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Calcula intención, probabilidades&lt;br&gt;y producto mencionado&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="bd" value="&lt;b style=&quot;font-size:16px&quot;&gt;Base de datos de PuntoBot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[SQLite]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Consultas, respuestas, versión&lt;br&gt;del modelo y correcciones&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="650" width="310" height="150" as="geometry"/></mxCell>
        <mxCell id="ext" value="&lt;b style=&quot;font-size:16px&quot;&gt;Sistema de inventario y facturación&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Productos, existencias, precios&lt;br&gt;y ventas (solo lectura)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="890" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="ent" value="&lt;b style=&quot;font-size:16px&quot;&gt;Entrenamiento del modelo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Notebook Jupyter + scikit-learn]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Corre en la PC del equipo,&lt;br&gt;no en la farmacia&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;dashed=1;dashPattern=10 6;" vertex="1" parent="1"><mxGeometry x="1390" y="650" width="320" height="150" as="geometry"/></mxCell>
