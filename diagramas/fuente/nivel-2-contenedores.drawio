        <mxCell id="vend" value="&lt;b style=&quot;font-size:16px&quot;&gt;Vendedor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Atiende en el mostrador y&lt;br&gt;pregunta por un producto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="340" height="120" as="geometry"/></mxCell>
