        <mxCell id="c19" value="Flecha continua: flujo en línea (1 a 5 = recorrido de una consulta; 5 es la respuesta)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#333;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="760" y="1159" width="400" height="22" as="geometry"/></mxCell>
